{
  "name": "ketsoc",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionDO" },
      { "name": "USER_DO", "class_name": "UserDO" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ketsoc",
      // Placeholder for local dev; run `pnpm db:create` to get the real id for remote.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO", "UserDO"]
    }
  ]
}
