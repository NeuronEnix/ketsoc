{
  "name": "ketsoc",
  "version": "0.0.1",
  "description": "Globally distributed socket",
  "keywords": [
    "socket"
  ],
  "homepage": "https://github.com/NeuronEnix/ketsoc#readme",
  "bugs": {
    "url": "https://github.com/NeuronEnix/ketsoc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuronEnix/ketsoc.git"
  },
  "license": "MIT",
  "author": "Kaushik R Bangera",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create ketsoc",
    "db:migrate:local": "wrangler d1 migrations apply ketsoc --local",
    "db:migrate": "wrangler d1 migrations apply ketsoc --remote",
    "db:migrations:list": "wrangler d1 migrations list ketsoc --local",
    "dashboard:dev": "pnpm --dir dashboard dev",
    "dashboard:build": "pnpm --dir dashboard build",
    "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepublishOnly": "pnpm build:clean && pnpm test",
    "prepack": "pnpm build:clean",
    "format": "prettier --write src",
    "format:staged": "lint-staged --config .lintstagedrc.json --allow-empty",
    "lint": "eslint --fix src",
    "lint:staged": "lint-staged --config .lintstagedrc.json --allow-empty",
    "lint-staged": "lint-staged --allow-empty",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.93.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3"
  }
}
