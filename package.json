{
  "name": "ketsoc",
  "version": "0.0.1",
  "description": "Globally distributed socket",
  "keywords": [
    "socket"
  ],
  "homepage": "https://github.com/NeuronEnix/ketsoc#readme",
  "bugs": {
    "url": "https://github.com/NeuronEnix/ketsoc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuronEnix/ketsoc.git"
  },
  "license": "MIT",
  "author": "Kaushik R Bangera",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "format": "prettier --write src",
    "format:staged": "lint-staged --config .lintstagedrc.json --allow-empty",
    "lint": "eslint --fix src",
    "lint:staged": "lint-staged --config .lintstagedrc.json --allow-empty",
    "lint-staged": "lint-staged --allow-empty",
    "prepare": "husky",
    "test": "echo \"no tests yet\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260522.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.93.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3"
  }
}
